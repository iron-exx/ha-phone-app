// Template for ios-app/Secrets.xcconfig (gitignored, never committed).
//
// Copy this file to `Secrets.xcconfig` and fill in the real HA-Phone
// test-extension host/port/username/password (from Plan 01's checkpoint
// output) before building against a real PBX. Values flow: this xcconfig
// -> project.yml's Info.plist $(SIP_TEST_*) substitution -> Info.plist ->
// read at runtime via Bundle.main in HAPhoneTestAppApp.swift. No secret is
// ever a Swift string literal in tracked source (Security V5 / swift
// security rule: use .xcconfig files for build-time secrets, never
// hardcode). This mirrors Plan 04's Android local.properties -> BuildConfig
// pattern.
//
// CI (ios-ci.yml) copies this example file to Secrets.xcconfig verbatim
// when no real one is present, so the Simulator structural build/test
// (D-15/D-16) succeeds without needing real credentials -- CI never
// exercises a live call.
SIP_TEST_HOST = 0.0.0.0
SIP_TEST_PORT = 5061
SIP_TEST_USERNAME = 0
SIP_TEST_PASSWORD = changeme
