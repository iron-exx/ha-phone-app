# Dev SIP test-extension credentials, read by app/build.gradle.kts into
# BuildConfig fields consumed by HAPhoneTestApplication.kt as a fallback
# when nothing is saved yet via the app's own Settings screen.
#
# Copy this file to sip-secrets.local.properties (gitignored) and fill in
# real values from your HA-Phone dev box. Deliberately NOT
# android/local.properties -- Flutter's tooling auto-writes/overwrites that
# file (sdk.dir, flutter.sdk) on every `flutter pub get`/IDE sync.
sip.test.host=
sip.test.port=
sip.test.username=
sip.test.password=
