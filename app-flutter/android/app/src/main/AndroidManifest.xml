<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-added for the QR-scan pairing flow (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Explicit: the debug build only gets INTERNET merged in by Flutter's debug manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Always-on SIP registration (SipService) + restart after reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- During a call SipService adds phoneCall|microphone, so the mic keeps working when the
         call was answered from the background (car, headset). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Ringing vibration (calls/RingtonePlayer). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Doze-proof re-REGISTER alarm (reach/RegistrationAlarm). User-grantable on API 31+
         ("Alarme & Erinnerungen"); without it the app falls back to inexact
         setAndAllowWhileIdle. USE_EXACT_ALARM is deliberately NOT used (Play policy:
         alarm/calendar apps only). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".HAPhoneTestApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="HA-Phone"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/NormalTheme"
        android:usesCleartextTraffic="true">

        <!-- Flutter's UI/business-logic entry point. Attaches to the
             pre-warmed cached FlutterEngine (see MainActivity.getCachedEngineId
             / HAPhoneTestApplication.onCreate). singleTop + onNewIntent handle
             the hand-off from IncomingCallActivity's Answer action without
             creating a second Activity instance. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Pairing link from the HA-Phone admin UI (same content as the QR code). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haphone" android:host="provision" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Native, deliberately not a FlutterActivity, see the class
             doc comment in IncomingCallActivity.kt for why. Own task (taskAffinity): it
             must not land on top of a MainActivity task left behind the keyguard by an
             earlier call, where it only came up as a heads-up instead of full screen. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:theme="@style/Theme.HAPhoneTest"
            android:launchMode="singleTop"
            android:taskAffinity="de.haphone.app.test.ringing"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".SipService"
            android:exported="false"
            android:foregroundServiceType="specialUse|phoneCall|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the SIP registration to the user's own PBX alive so incoming VoIP calls ring" />
        </service>

        <!-- Embedded Tailscale: split-tunnel VPN, only the tailnet (100.64.0.0/10). -->
        <service
            android:name=".tailscale.TsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- "Tür öffnen" from the quick settings tile / app shortcut; always asks first. -->
        <activity
            android:name=".quick.DoorOpenConfirmActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <service
            android:name=".quick.DoorOpenTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_haphone"
            android:label="Tür öffnen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".tailscale.TsConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Debug hook for adb (tailscale join/status/logout). DUMP = only shell/system can send;
             the receiver additionally ignores everything in release builds. -->
        <receiver
            android:name=".tailscale.TsDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Home screen widget: last doorbell picture + "Tür öffnen" (with confirmation). -->
        <receiver android:name=".quick.DoorWidgetProvider" android:exported="false"
            android:label="@string/shortcut_door_open">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/door_widget_info" />
        </receiver>

        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".CallActionReceiver" android:exported="false" />

        <!-- Registration refresh / service restart alarms; re-arms when exact alarms get allowed. -->
        <receiver android:name=".reach.RegistrationAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Android Auto (Car App Library). CALLING category: Favoriten, Verlauf, Kontakte,
             Haustür. The in-call view comes from Android Auto via our Telecom integration. -->
        <service
            android:name=".car.HaPhoneCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.CALLING" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- TabTemplate needs level 6; older hosts get the plain menu (CarRootScreen.menu). -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service android:name=".TestFcmService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
