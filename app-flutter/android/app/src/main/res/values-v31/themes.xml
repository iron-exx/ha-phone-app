<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen for MainActivity. Same names as
         values/themes.xml; only LaunchTheme gets the splash attributes. -->
    <style name="LaunchTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/haphone_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
